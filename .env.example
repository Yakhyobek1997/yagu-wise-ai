# ============================================================================
# YaguWiseAi configuration — copy to `.env` and edit. ALL settings are optional
# except HUGGINGFACE_TOKEN (only required for gated models/datasets, e.g.
# pyannote diarization). The system runs fully local at $0 without any keys.
# Every variable is prefixed with YAGUWISEAI_ except the well-known token names.
# ============================================================================

# ---- Required only for gated HF assets (diarization, some datasets) ----
HUGGINGFACE_TOKEN=

# ---- Core ----
YAGUWISEAI_ENV=local                 # local | dev | prod
YAGUWISEAI_LOG_LEVEL=INFO
YAGUWISEAI_LOG_JSON=false            # true => structured JSON logs
YAGUWISEAI_DATA_DIR=./data
YAGUWISEAI_REPORTS_DIR=./reports
YAGUWISEAI_SEED=42

# ---- Embeddings ----
YAGUWISEAI_EMBEDDING__PROVIDER=auto  # auto | bge | hash | openai
YAGUWISEAI_EMBEDDING__MODEL=BAAI/bge-m3
YAGUWISEAI_EMBEDDING__DIM=1024       # used by hash fallback / collection sizing
YAGUWISEAI_EMBEDDING__DEVICE=auto    # auto | cpu | cuda

# ---- Vector store (Qdrant) ----
YAGUWISEAI_VECTOR__BACKEND=auto      # auto | qdrant | memory
YAGUWISEAI_VECTOR__URL=http://localhost:6333
YAGUWISEAI_VECTOR__COLLECTION=yaguwiseai
YAGUWISEAI_VECTOR__QUANTIZATION=none # none | scalar | binary

# ---- Reranking ----
YAGUWISEAI_RERANK__PROVIDER=auto     # auto | bge | cohere | none
YAGUWISEAI_RERANK__MODEL=BAAI/bge-reranker-v2-m3

# ---- Retrieval / router ----
YAGUWISEAI_RETRIEVAL__TOP_K=20
YAGUWISEAI_RETRIEVAL__FINAL_K=6
YAGUWISEAI_RETRIEVAL__RRF_K=60

# ---- LLM generation ----
YAGUWISEAI_LLM__PROVIDER=auto        # auto | ollama | openai | anthropic | cohere | extractive
YAGUWISEAI_LLM__MODEL=llama3.2:3b
YAGUWISEAI_LLM__BASE_URL=http://localhost:11434
YAGUWISEAI_LLM__TEMPERATURE=0.1
YAGUWISEAI_LLM__MAX_TOKENS=1024

# ---- Agent loop ----
YAGUWISEAI_AGENT__MAX_ITERS=3
YAGUWISEAI_AGENT__LATENCY_BUDGET_MS=15000
YAGUWISEAI_AGENT__SEMANTIC_CACHE=true

# ---- Voice ----
YAGUWISEAI_VOICE__ASR_PROVIDER=auto  # auto | faster_whisper | whisperx | null
YAGUWISEAI_VOICE__ASR_MODEL=base
YAGUWISEAI_VOICE__TTS_PROVIDER=auto  # auto | kokoro | null
YAGUWISEAI_VOICE__DIARIZE=true
YAGUWISEAI_VOICE__VAD=true

# ---- Serving ----
YAGUWISEAI_SERVE__HOST=0.0.0.0
YAGUWISEAI_SERVE__PORT=8000
YAGUWISEAI_SERVE__RATE_LIMIT_PER_MIN=120
# Per-upload size cap for /ingest and /voice (applied at the API layer).
# The Caddy proxy enforces an independent hard cap via YAGUWISEAI_MAX_BODY_SIZE.
YAGUWISEAI_SERVE__MAX_UPLOAD_MB=50
# Caddy proxy hard cap on incoming request bodies (prevents DoS before API layer).
YAGUWISEAI_MAX_BODY_SIZE=100MB
# Optional bearer-token auth. Empty == open (local/demo). When set, every endpoint
# except /health and /metrics requires `Authorization: Bearer <key>`.
YAGUWISEAI_SERVE__API_KEY=

# ---- Container images (podman-compose ${...} substitution) ----
# Which images compose runs. Defaults to locally-built images at the package
# version. Point at GHCR to deploy a pinned published version:
#   YAGUWISEAI_IMAGE_PREFIX=ghcr.io/<owner>/yaguwiseai-   YAGUWISEAI_IMAGE_TAG=0.1.0
YAGUWISEAI_IMAGE_PREFIX=yaguwiseai-
YAGUWISEAI_IMAGE_TAG=0.1.0
# Registry/namespace for `make push` (build/push scripts). Lowercase for GHCR.
YAGUWISEAI_REGISTRY=ghcr.io
YAGUWISEAI_IMAGE_NAMESPACE=<owner-lowercase>

# ---- Containerized remote deployment (podman-compose ${...} substitution) ----
# Single public HTTPS port via the Caddy TLS proxy (only service on 0.0.0.0).
YAGUWISEAI_HTTPS_PORT=8443
YAGUWISEAI_CERT_HOST=localhost          # self-signed cert SAN (server IP or domain)
YAGUWISEAI_SITE_ADDRESS=:8443           # or https://your.domain for Let's Encrypt
YAGUWISEAI_BIND_INTERNAL=127.0.0.1      # internal services bind here (off public NIC)
YAGUWISEAI_WEB_PORT=3000                # web UI loopback publish (debug only)
# Browser → same-origin proxy (no IP/secret in the bundle); CORS = the HTTPS origin.
NEXT_PUBLIC_API_BASE=/api
# CORS origins — defaults to strict loopback for local dev. For a deployed stack,
# set this to the exact HTTPS origin(s) serving the UI. Wildcards ("*") are unsafe.
# YAGUWISEAI_SERVE__CORS_ORIGINS=["https://<SERVER_IP>:8443"]

# ---- MCP server ----
YAGUWISEAI_MCP_TRANSPORT=stdio          # stdio | streamable-http | sse
YAGUWISEAI_MCP_HOST=0.0.0.0             # bind for HTTP transports
YAGUWISEAI_MCP_PORT=8765
# Bearer auth on the HTTP MCP transports. Empty == open (stdio/local). When set,
# remote clients must send `Authorization: Bearer <key>`. Falls back to
# YAGUWISEAI_SERVE__API_KEY if this is empty.
YAGUWISEAI_MCP_API_KEY=

# ---- Air-gap / local-only safeguard ----
# Set to true to guarantee zero data egress to external LLM/embedding/telemetry
# providers regardless of which API keys are present. Forces the "auto" factory
# to resolve only to Ollama (if reachable) or the built-in extractive fallback.
# Langfuse export is also suppressed. Recommended for sensitive deployments.
YAGUWISEAI_AIR_GAPPED=false

# ---- Telemetry ----
YAGUWISEAI_TELEMETRY__ENABLED=true
YAGUWISEAI_TELEMETRY__PHOENIX_ENDPOINT=http://localhost:6006
YAGUWISEAI_TELEMETRY__OTLP_ENDPOINT=
# Strip PII (emails, phone numbers, SSNs, IPs, card numbers) from trace
# inputs/outputs before they are exported to Langfuse or Phoenix. Default: true.
# Set to false only when you have an explicit legal basis to store raw queries.
YAGUWISEAI_TELEMETRY__PII_FILTER=true
# Langfuse (hosted trace/eval). Activated when both LANGFUSE_* keys are set AND
# the langfuse SDK is installed (`pip install 'yaguwiseai[telemetry]'`). Self-host?
# set the host below; default is Langfuse Cloud.
YAGUWISEAI_TELEMETRY__LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Optional paid providers (auto-detected; never required) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
# Langfuse keys — both required to enable hosted tracing (see telemetry above).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

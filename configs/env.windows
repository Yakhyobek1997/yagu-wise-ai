# ============================================================================
# Auralynq — Device profile: Windows (CUDA or CPU)
# Hardware: unknown GPU — auto-detect at runtime
# Stack:    Ollama for Windows + SLM fallback · ChromaDB embedded
# Copy to .env at repo root before starting.
#
# Setup steps (Windows — PowerShell as Administrator):
#   # 1. Install Ollama for Windows (https://ollama.com/download/windows)
#   #    Ollama installs as a Windows service; no separate daemon start needed.
#
#   # 2. Pull models (in PowerShell or CMD):
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
#
#   # 3. Install Python deps (in your venv):
#   pip install "auralynq[ingest,slm]"
#
#   # 4. For CUDA SLM (optional, NVIDIA GPU only):
#   pip install llama-cpp-python `
#     --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu124
#
#   # 5. Node + frontend:
#   #    Install Node.js LTS from https://nodejs.org/
#   cd web && npm install
#
#   # 6. Copy this file to .env at repo root and start:
#   copy configs\env.windows .env
#   python -m uvicorn auralynq.serving:app --host 0.0.0.0 --port 8000
#   cd web && npm run dev
#
# Note: paths use forward slashes — Python handles this on Windows.
# ============================================================================

# ── Network ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
AURALYNQ_SERVE__CORS_ORIGINS=["http://localhost:3000"]
AURALYNQ_SERVE__API_KEY=

# ── LLM (auto → Ollama first; SLM fallback) ─────────────────────────────────
AURALYNQ_LLM__PROVIDER=auto
AURALYNQ_LLM__MODEL=llama3.2:3b
# SLM fallback: auto-selects CUDA or CPU
AURALYNQ_LLM__SLM_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
AURALYNQ_LLM__SLM_FILENAME=qwen2.5-0.5b-instruct-q4_k_m.gguf
AURALYNQ_LLM__SLM_N_GPU_LAYERS=-1   # -1 = auto (CUDA if available, CPU otherwise)

# ── Embeddings ──────────────────────────────────────────────────────────────
AURALYNQ_EMBEDDING__PROVIDER=auto

# ── Vector store: ChromaDB embedded (no separate server on Windows) ──────────
AURALYNQ_VECTOR__BACKEND=chroma
AURALYNQ_VECTOR__CHROMA_PERSIST_DIR=./data/vectorstore

# ── Visual grounding ────────────────────────────────────────────────────────
AURALYNQ_VISUAL__ENABLED=true
AURALYNQ_VISUAL__PAGE_RENDERING_ENABLED=true
AURALYNQ_VISUAL__RENDER_DPI=144

# ── Optional paid providers ──────────────────────────────────────────────────
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=

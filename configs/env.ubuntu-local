# ============================================================================
# Auralynq — Device profile: Ubuntu local workstation
# Hardware: unknown GPU (CUDA/CPU) — auto-detect at runtime
# Stack:    Ollama (GPU if CUDA present, CPU otherwise)
#           SLM fallback (llama-cpp-python CUDA or CPU build)
#           ChromaDB embedded (simpler than running a Qdrant binary)
# Copy to .env at repo root before starting.
#
# Setup steps (Ubuntu):
#   # Install Ollama
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
#
#   # Install Python deps
#   pip install "auralynq[ingest,slm]"
#
#   # For CUDA SLM (optional, if CUDA GPU present):
#   pip install llama-cpp-python \
#     --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu124
#
#   cp configs/env.ubuntu-local .env
#   uvicorn auralynq.serving:app --host 0.0.0.0 --port 8000
#   cd web && npm install && npm run dev
# ============================================================================

# ── Network ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
AURALYNQ_SERVE__CORS_ORIGINS=["http://localhost:3000"]
AURALYNQ_SERVE__API_KEY=

# ── LLM (auto → Ollama first; SLM fallback) ─────────────────────────────────
AURALYNQ_LLM__PROVIDER=auto
AURALYNQ_LLM__MODEL=llama3.2:3b
# SLM fallback: auto-detects CUDA vs CPU at runtime
AURALYNQ_LLM__SLM_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
AURALYNQ_LLM__SLM_FILENAME=qwen2.5-0.5b-instruct-q4_k_m.gguf
AURALYNQ_LLM__SLM_N_GPU_LAYERS=-1   # -1 = auto (GPU if CUDA, CPU otherwise)

# ── Embeddings ──────────────────────────────────────────────────────────────
AURALYNQ_EMBEDDING__PROVIDER=auto

# ── Vector store: ChromaDB embedded ─────────────────────────────────────────
AURALYNQ_VECTOR__BACKEND=chroma
AURALYNQ_VECTOR__CHROMA_PERSIST_DIR=./data/vectorstore

# ── Visual grounding ────────────────────────────────────────────────────────
AURALYNQ_VISUAL__ENABLED=true
AURALYNQ_VISUAL__PAGE_RENDERING_ENABLED=true
AURALYNQ_VISUAL__RENDER_DPI=144

# ── Optional paid providers ──────────────────────────────────────────────────
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=

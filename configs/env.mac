# ============================================================================
# Auralynq — Device profile: macOS (MacBook Pro)
# Hardware: Apple Silicon (M-series) or Intel — Metal GPU / CPU only
# Stack:    Ollama (Metal backend) or SLM (llama-cpp-python Metal build)
#           ChromaDB embedded (no separate vector server needed)
# Copy to .env at repo root before starting.
#
# Setup steps (Mac):
#   brew install ollama node
#   ollama pull llama3.2:3b          # ~2 GB, Metal-accelerated
#   ollama pull nomic-embed-text
#   pip install "auralynq[ingest,slm]"
#   cp configs/env.mac .env
#   uvicorn auralynq.serving:app --host 0.0.0.0 --port 8000
#   cd web && npm install && npm run dev
# ============================================================================

# ── Network ─────────────────────────────────────────────────────────────────
# Replace <MAC_IP> with your Mac's LAN IP (System Settings → Network)
# or use localhost if running frontend and API on the same machine.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
AURALYNQ_SERVE__CORS_ORIGINS=["http://localhost:3000"]
AURALYNQ_SERVE__API_KEY=

# ── LLM (auto → Ollama Metal first; SLM if Ollama down) ─────────────────────
AURALYNQ_LLM__PROVIDER=auto
AURALYNQ_LLM__MODEL=llama3.2:3b     # 3B is fast on Apple Silicon Metal
# SLM fallback: Metal build of llama-cpp-python
# Install: CMAKE_ARGS="-DLLAMA_METAL=on" pip install llama-cpp-python
AURALYNQ_LLM__SLM_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
AURALYNQ_LLM__SLM_FILENAME=qwen2.5-0.5b-instruct-q4_k_m.gguf
AURALYNQ_LLM__SLM_N_GPU_LAYERS=-1   # Metal: -1 = all layers on GPU

# ── Embeddings (auto → Ollama nomic-embed-text first) ───────────────────────
AURALYNQ_EMBEDDING__PROVIDER=auto

# ── Vector store: ChromaDB embedded (no server) ──────────────────────────────
# data/vectorstore/ is created automatically on first ingest.
AURALYNQ_VECTOR__BACKEND=chroma
AURALYNQ_VECTOR__CHROMA_PERSIST_DIR=./data/vectorstore

# ── Visual grounding ────────────────────────────────────────────────────────
# PyMuPDF renders PDF pages natively — no extra install needed.
AURALYNQ_VISUAL__ENABLED=true
AURALYNQ_VISUAL__PAGE_RENDERING_ENABLED=true
AURALYNQ_VISUAL__RENDER_DPI=144

# ── Optional paid providers ──────────────────────────────────────────────────
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=
